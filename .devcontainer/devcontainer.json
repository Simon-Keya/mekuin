{
  "name": "MEKU-In development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.24.13"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "go version && node --version && corepack enable",
  "customizations": {
    "vscode": {
      "extensions": ["golang.go", "bradlc.vscode-tailwindcss", "esbenp.prettier-vscode"]
    }
  }
}
