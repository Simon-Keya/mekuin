POSTGRES_DB=mekuin
POSTGRES_USER=mekuin
POSTGRES_PASSWORD=replace-with-url-safe-random-secret
API_PORT=8080
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Local-only runtime role password. Rotate and inject from a secret manager outside development.
MEKUIN_APP_PASSWORD=replace-with-a-second-independent-url-safe-random-secret

# Staff invitation email delivery (worker retries queued messages; configure for delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Required for registration verification and password recovery
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
APP_BASE_URL=http://localhost:3000

# Safaricom Daraja (leave unset until merchant credentials and HTTPS callback are provisioned)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
# Optional override; must be HTTPS. Defaults to Safaricom sandbox/production hosts.
DARAJA_BASE_URL=
